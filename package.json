{
  "name": "@trivial-so/cli",
  "version": "0.20.1",
  "type": "module",
  "description": "The terminal client for Trivial \u2014 your projects, on your machine.",
  "license": "MIT",
  "homepage": "https://trivial.so",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trivial-so/cli.git"
  },
  "bugs": {
    "url": "https://github.com/trivial-so/cli/issues"
  },
  "keywords": [
    "trivial",
    "cli",
    "vite",
    "react",
    "publish",
    "deploy"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "trivial": "dist/trivial.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.mjs",
    "test": "npm run build && node --test test/cli.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
